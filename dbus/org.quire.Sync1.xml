<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
 <interface name="org.quire.Sync1">
   <method name="Datasets">
     <arg type="as" direction="out"/>
   </method>
   <method name="Status">
     <arg name="dataset" type="s" direction="in"/>
     <arg type="a{sv}" direction="out"/>
   </method>
   <method name="Pause">
     <arg name="dataset" type="s" direction="in"/>
   </method>
   <method name="Resume">
     <arg name="dataset" type="s" direction="in"/>
   </method>
   <signal name="Progress">
     <arg name="dataset" type="s"/>
     <arg name="progress" type="a{sv}"/>
   </signal>
   <signal name="Conflict">
     <arg name="dataset" type="s"/>
     <arg name="conflict" type="a{sv}"/>
   </signal>
 </interface>
</node>
