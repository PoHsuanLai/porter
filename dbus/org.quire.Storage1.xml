<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
 <interface name="org.quire.Storage1">
   <method name="Drives">
     <arg type="a(sa{sv})" direction="out"/>
   </method>
   <method name="Items">
     <arg name="paths" type="as" direction="in"/>
     <arg type="a{sa{sv}}" direction="out"/>
   </method>
   <method name="Download">
     <arg name="paths" type="as" direction="in"/>
     <arg type="a{ss}" direction="out"/>
   </method>
   <method name="Keep">
     <arg name="paths" type="as" direction="in"/>
     <arg name="keep" type="b" direction="in"/>
     <arg type="a{ss}" direction="out"/>
   </method>
   <method name="RemoveDownload">
     <arg name="paths" type="as" direction="in"/>
     <arg type="a{ss}" direction="out"/>
   </method>
   <method name="SaveCopy">
     <arg name="paths" type="as" direction="in"/>
     <arg name="saved" type="a{ss}" direction="out"/>
     <arg name="refused" type="a{ss}" direction="out"/>
   </method>
   <method name="SetPaused">
     <arg name="drives" type="as" direction="in"/>
     <arg name="paused" type="b" direction="in"/>
     <arg type="a{ss}" direction="out"/>
   </method>
   <method name="Watch">
   </method>
   <signal name="DrivesChanged">
   </signal>
   <signal name="ItemsChanged">
     <arg name="drive" type="s"/>
     <arg name="items" type="a{sa{sv}}"/>
   </signal>
 </interface>
</node>
