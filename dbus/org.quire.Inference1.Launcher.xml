<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
 <interface name="org.quire.Inference1.Launcher">
   <method name="SetAgentState">
     <arg name="account" type="s" direction="in"/>
     <arg name="state" type="s" direction="in"/>
   </method>
   <method name="RegisterLauncher">
     <arg name="programs" type="as" direction="in"/>
   </method>
   <method name="BeginSession">
     <arg name="session" type="s" direction="in"/>
   </method>
   <method name="EndSession">
     <arg name="session" type="s" direction="in"/>
   </method>
   <method name="RequestAgentKey">
     <arg name="program" type="s" direction="in"/>
     <arg name="class" type="s" direction="in"/>
     <arg name="session" type="s" direction="in"/>
     <arg name="parent_window" type="s" direction="in"/>
     <arg name="options" type="a{sv}" direction="in"/>
     <arg type="o" direction="out"/>
   </method>
   <method name="ReportAgentLogin">
     <arg name="request" type="s" direction="in"/>
     <arg name="outcome" type="s" direction="in"/>
     <arg name="reason" type="s" direction="in"/>
   </method>
   <method name="ReportAgentLogout">
     <arg name="request" type="s" direction="in"/>
     <arg name="outcome" type="s" direction="in"/>
     <arg name="reason" type="s" direction="in"/>
   </method>
   <method name="IssueProcessCredential">
     <arg name="permit" type="s" direction="in"/>
     <arg name="program" type="s" direction="in"/>
     <arg name="target" type="s" direction="in"/>
     <arg type="s" direction="out"/>
     <arg type="v" direction="out"/>
   </method>
   <method name="RevokeProcessCredential">
     <arg name="id" type="s" direction="in"/>
   </method>
   <signal name="AgentLoginRequested">
     <arg name="request" type="s"/>
     <arg name="account" type="s"/>
     <arg name="program" type="s"/>
   </signal>
   <signal name="AgentLogoutRequested">
     <arg name="request" type="s"/>
     <arg name="account" type="s"/>
     <arg name="program" type="s"/>
   </signal>
   <signal name="ProcessCredentialRevoked">
     <arg name="id" type="s"/>
     <arg name="reason" type="s"/>
   </signal>
 </interface>
</node>
