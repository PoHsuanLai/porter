# accountd as a systemd user unit: the account registry, consent store and token broker
# (org.quire.Accounts1 on the session bus). It is found, and started, by D-Bus activation
# (dbus/org.quire.Accounts1.service) the first time an app asks for an account.
#
# accountd talks to the session bus, the Secret Service on it, the sheet host (sill) on it, and
# the network (provider sign-in and revocation). It reads /proc to know who is calling, so the
# unit must not hide other processes' cgroups (no ProtectProc, no PrivatePID).
[Unit]
Description=quire accounts and consent (org.quire.Accounts1)

[Service]
Type=dbus
BusName=org.quire.Accounts1
ExecStart=/usr/libexec/quire/accountd
Restart=on-failure
RestartSec=2
# 78: accountd found a registry file it cannot read and stopped on purpose (it says which files
# in the journal). Restarting would only repeat that every two seconds, so the unit stays
# stopped until the person has looked at it.
RestartPreventExitStatus=78
KillMode=control-group
TimeoutStopSec=20

# --- Sandbox ---
# Unix sockets for the bus, and the internet for the providers.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The person's files are out of reach except what accountd writes: the registry (porter/ under
# $XDG_STATE_HOME), its audit file (quire/accountd/ there) and the user's clients file and caller
# table (porter/ under $XDG_CONFIG_HOME; Settings writes them through accountd). systemd creates
# them before the sandbox starts.
ProtectHome=read-only
ProtectSystem=strict
StateDirectory=porter quire/accountd
ConfigurationDirectory=porter
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Files accountd creates are private to it.
UMask=0077

[Install]
WantedBy=default.target
