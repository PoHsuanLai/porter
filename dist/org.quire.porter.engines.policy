<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  Installing an AI engine for everyone on this computer: the one thing the helper
  /usr/libexec/quire/porter-engine-helper does as root. `pkexec` starts it with an engine and a
  backend by name and nothing else; what it downloads, and from where, is compiled into it.
  scripts/install.sh installs this file at share/polkit-1/actions/ and changes the path below to
  the install's libexec directory.
-->
<policyconfig>
  <vendor>quire</vendor>
  <vendor_url>https://github.com/PoHsuanLai/porter</vendor_url>
  <action id="org.quire.porter.engines.install">
    <description>Install an AI engine for everyone</description>
    <message>Authentication is required to install software that runs AI models for everyone on this computer.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/quire/porter-engine-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
