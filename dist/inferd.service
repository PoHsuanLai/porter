# inferd as a systemd user unit: the AI broker (org.quire.Inference1 on the session bus). It is
# found, and started, by D-Bus activation (dbus/org.quire.Inference1.service) the first time a
# caller opens a session; no engine runs until a session asks for its model.
#
# inferd runs the engines (llama-server, vLLM, the speech host) as child processes, so this unit's
# sandbox is the engines' sandbox: it has to let them reach the GPU and read the weights, and
# nothing else. The per-engine sandbox that models section 3.9 describes (a transient systemd unit
# for each engine, with its own PrivateNetwork and a read-only bind of just its weights) is not
# built: when it is, this unit loses the device lines and the engines gain them.
[Unit]
Description=quire AI broker (org.quire.Inference1)

[Service]
# Fixed role (porter_dbus::LOADER_VARIABLES): the manager's environment must not reach this unit.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH GIO_EXTRA_MODULES GTK_MODULES GTK_PATH GST_PLUGIN_PATH GST_PLUGIN_SYSTEM_PATH LIBGL_DRIVERS_PATH MESA_LOADER_DRIVER_OVERRIDE __EGL_VENDOR_LIBRARY_DIRS __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH LIBVA_DRIVERS_PATH VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_LAYER_PATH VK_ADD_LAYER_PATH VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE
Type=dbus
BusName=org.quire.Inference1
ExecStart=/usr/libexec/quire/inferd
Restart=on-failure
RestartSec=2
# An engine can take minutes to load weights; stopping inferd stops them with it.
KillMode=control-group
TimeoutStopSec=20

# --- Sandbox ---
# The keys that need a mount namespace are in the drop-in sandbox.conf (see its header).
# Unix sockets (the session bus, and the engines' sockets under %t/inferd) and this computer's own
# loopback addresses only: the local runtimes the probe asks (Ollama, LM Studio, llama.cpp
# server) and the agent endpoint's listener are on 127.0.0.1 / ::1, which PrivateNetwork would
# hide. IPAddressDeny=any with IPAddressAllow=localhost leaves every other address unreachable,
# so a compromised engine cannot send what it was shown anywhere, and weights are never fetched
# from here (HF_HUB_OFFLINE=1 in every engine's environment).
#
# Hosted models (a cloud account the person added and granted) need the network. That is an
# opt-in drop-in, dist/inferd-cloud.conf, installed by the person (or by Settings when a cloud
# account is added) as $XDG_CONFIG_HOME/systemd/user/inferd.service.d/cloud.conf: the engines
# share this sandbox until each has its own (models section 3.9), so a person who stays
# on-device keeps an inferd that cannot reach the network at all.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
# What inferd writes: its engines' sockets (the runtime directory, %t/inferd) and its state (the
# audit file and the spend ledger, under $XDG_STATE_HOME/quire/inferd). systemd creates both
# before the sandbox starts. The rest of the person's files are read-only (ProtectHome in
# sandbox.conf), so the weights cache is read through that.
#
# inferd also holds the person's AI keys: the registry of the accounts and the permissions given
# to apps is keys/registry.json in the state directory (the keys themselves are in the Secret
# Service, under the name porter.inferd, which the session bus reaches), and the credential
# files it hands to the processes of an agent are under %t/inferd/agent (a directory of its
# own, private to the person, emptied when inferd starts and when a credential ends).
# Checking a key when it is added is one call to the company, which needs the network drop-in
# below; without it the add sheet says the service could not be reached.
RuntimeDirectory=inferd inferd/agent
RuntimeDirectoryMode=0700
StateDirectory=quire/inferd
# No setuid gain. MemoryDenyWriteExecute is NOT set: CUDA and the engines' JIT need writable and
# executable memory.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
# No capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=
# The GPU, and no other device: the NVIDIA character devices by their /proc/devices names (to be
# verified on a machine with the driver: spike S1). The default policy closes everything else.
DevicePolicy=closed
DeviceAllow=char-nvidia-frontend rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-nvidia-caps rw
# Files inferd and its engines create are private to them.
UMask=0077

[Install]
WantedBy=default.target
