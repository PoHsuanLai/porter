# inferd as a systemd user unit: the AI broker (org.quire.Inference1 on the session bus). It is
# found, and started, by D-Bus activation (dbus/org.quire.Inference1.service) the first time a
# caller opens a session; no engine runs until a session asks for its model.
#
# inferd runs the engines (llama-server, vLLM, the speech host) as child processes, so this unit's
# sandbox is the engines' sandbox: it has to let them reach the GPU and read the weights, and
# nothing else. The per-engine sandbox that models section 3.9 describes (a transient systemd unit
# for each engine, with its own PrivateNetwork and a read-only bind of just its weights) is not
# built: when it is, this unit loses the device lines and the engines gain them.
[Unit]
Description=quire AI broker (org.quire.Inference1)

[Service]
Type=dbus
BusName=org.quire.Inference1
ExecStart=/usr/libexec/quire/inferd
Restart=on-failure
RestartSec=2
# An engine can take minutes to load weights; stopping inferd stops them with it.
KillMode=control-group
TimeoutStopSec=20

# --- Sandbox ---
# Only Unix sockets: the session bus, and the engines' sockets under %t/inferd. Nothing can reach
# the network, so a compromised engine cannot send what it was shown anywhere, and weights are
# never fetched from here (HF_HUB_OFFLINE=1 in every engine's environment).
#
# Hosted models (a cloud account the person added and granted) need the network. That is an
# opt-in drop-in, dist/inferd-cloud.conf, installed by the person (or by Settings when a cloud
# account is added) as $XDG_CONFIG_HOME/systemd/user/inferd.service.d/cloud.conf: the engines
# share this sandbox until each has its own (models section 3.9), so a person who stays
# on-device keeps an inferd that cannot reach the network at all.
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
# The person's files are out of reach except what inferd writes: its engines' sockets (the
# runtime directory, %t/inferd) and its state (the audit file and the spend ledger, under
# $XDG_STATE_HOME/quire/inferd). systemd creates both before the sandbox starts. The weights
# cache is read through ProtectHome=read-only.
ProtectHome=read-only
ProtectSystem=strict
RuntimeDirectory=inferd
StateDirectory=quire/inferd
# Engines write scratch files (vLLM, torch and Triton caches): private, and gone with the unit.
PrivateTmp=yes
# No setuid gain. MemoryDenyWriteExecute is NOT set: CUDA and the engines' JIT need writable and
# executable memory.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
# No kernel, module or debug surfaces.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# No capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=
# The GPU, and no other device: the NVIDIA character devices by their /proc/devices names (to be
# verified on a machine with the driver: spike S1). The default policy closes everything else.
DevicePolicy=closed
DeviceAllow=char-nvidia-frontend rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-nvidia-caps rw
# Files inferd and its engines create are private to them.
UMask=0077

[Install]
WantedBy=default.target
